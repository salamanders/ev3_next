[Unit]
Description=LEGO Mindstorms EV3 Web Motor Control Server
Documentation=https://github.com/ev3dev/ev3dev
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/robot
ExecStartPre=/bin/sh -c 'dmesg -n 1 2>/dev/null || true'
ExecStart=/home/robot/ev3-web-motor --port 80 --poll-interval 50
ExecStopPost=/bin/sh -c 'for m in /sys/class/tacho-motor/motor*; do [ -d "$m" ] && echo reset > "$m/command" 2>/dev/null || true; done; for l in /sys/class/leds/*:brick-status/brightness; do [ -f "$l" ] && echo 0 > "$l" 2>/dev/null || true; done'
Restart=always
RestartSec=2
StandardOutput=journal
StandardError=journal
TTYPath=/dev/tty1
TTYReset=yes

# Safe process priority for single-core 300MHz ARM9
Nice=-5
LimitNOFILE=1024

[Install]
WantedBy=multi-user.target

