[Unit]
Description=LEGO Mindstorms EV3 Web Motor Control Server
Documentation=https://github.com/ev3dev/ev3dev
After=basic.target
DefaultDependencies=no

[Service]
Type=simple
User=root
WorkingDirectory=/home/robot
ExecStart=/home/robot/ev3-web-motor --port 80 --poll-interval 50
Restart=always
RestartSec=1
StandardOutput=journal
StandardError=journal

# Performance optimizations for 300MHz ARM9
CPUSchedulingPolicy=rr
CPUSchedulingPriority=50
LimitNOFILE=1024

[Install]
WantedBy=basic.target
